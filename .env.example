# Public keys (shipped to browser) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Secret key — used only by supabase/functions/ingest-articles ---------
# In Supabase-hosted Edge Functions this is provided automatically as
# SUPABASE_SERVICE_ROLE_KEY; you only need to set it locally for
# `supabase functions serve` or for your own server-side scripts.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_KEY
